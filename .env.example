# Postgres connection strings (Vercel Postgres / Neon)
# DATABASE_URL: pooled (pgbouncer) connection, used by the app at runtime
# DIRECT_URL: unpooled connection, used only when running `prisma migrate`
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Single-user auth
ADMIN_PASSWORD="change-me"
AUTH_SECRET="generate-a-long-random-string"

# GoHighLevel
GHL_API_KEY=""
GHL_LOCATION_ID=""

# Meta Marketing API
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""

# Alerting
RESEND_API_KEY=""
ALERT_EMAIL=""
ALERT_THRESHOLD_PERCENT="10"

# Set by Vercel automatically to protect cron endpoints; also send this as a
# Bearer token if you ever trigger a cron route manually.
CRON_SECRET=""
