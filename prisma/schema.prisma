// Ad Reconciliation Dashboard — data model
//
// Data flow:
//   1. The tracking script (public/track.js) runs on every funnel page. It
//      assigns/reads a first-party visitor id cookie, captures fbclid/UTM/
//      ad ids from the URL, and POSTs them to /api/track -> ClickEvent. It
//      also writes that same visitor id into a single GHL hidden field.
//   2. GHL order/opportunity webhooks create GhlOrder rows, linked to a
//      GhlContact. If the contact carries the visitor id hidden field, we
//      look up ClickEvent by it and copy the attribution data onto
//      GhlContact — no need for GHL to reliably capture 6+ separate fields.
//   3. Meta Marketing API daily pull creates MetaInsight rows (spend,
//      reported purchases/revenue) at campaign/adset/ad level.
//   4. A rollup job joins GhlOrder -> GhlContact (for ad attribution) against
//      MetaInsight to produce DailyReconciliation and AdAttribution rows,
//      which the dashboard reads directly (no heavy joins at request time).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) connection, used at runtime
  directUrl = env("DIRECT_URL") // unpooled connection, used only for migrations
}

// A GHL contact, enriched with the attribution data our tracking script
// captured at the moment they opted in. One contact can place many orders.
model GhlContact {
  id            String   @id // GHL contact id, used as-is (no surrogate key)
  email         String?
  phone         String?
  visitorId     String? // from the "rcl_visitor_id" hidden field -> joins to ClickEvent
  fbclid        String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  adId          String? // Meta ad id, copied from the matched ClickEvent
  adsetId       String?
  campaignId    String?
  firstSeenAt   DateTime? // ClickEvent.firstSeenAt for the matched visitor, not GHL's createdAt
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        GhlOrder[]

  @@index([adId])
  @@index([email])
  @@index([visitorId])
}

// One row per visitor, written by the tracking script. Last-touch: a
// returning visitor's later click overwrites the ad/UTM fields here, so
// attribution reflects whichever ad most recently drove them back.
model ClickEvent {
  visitorId    String   @id
  fbclid       String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  adId         String?
  adsetId      String?
  campaignId   String?
  landingUrl   String?
  referrer     String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  @@index([adId])
}

// A single GHL order, pulled via polling GET /payments/orders (not a
// webhook — see lib/ghl.ts syncGhlOrders and app/api/cron/ghl-sync).
model GhlOrder {
  id            String     @id // GHL order _id
  contactId     String
  contact       GhlContact @relation(fields: [contactId], references: [id])
  amount        Decimal    @db.Decimal(12, 2)
  currency      String     @default("USD")
  productId     String?
  productName   String?
  // Raw signal from GHL's order.sourceSubType/sourceName/sourceMeta —
  // e.g. "upsell", "one_step_order_form". Not yet mapped to our fixed
  // FRONT_END/ORDER_BUMP_*/UPSELL_* buckets since GHL doesn't say which
  // numbered upsell/bump a step is — mapping that precisely needs the
  // step IDs confirmed against the real funnel first.
  sourceType    String?
  sourceSubType String?
  sourceName    String?
  sourceStepId  String?
  sourcePageId  String?
  // FRONT_END | ORDER_BUMP_1 | ORDER_BUMP_2 | UPSELL_1 | UPSELL_2 | UPSELL_3 | UNKNOWN
  funnelStage   String     @default("UNKNOWN")
  status        String // GHL order.status, e.g. completed, refunded, void
  occurredAt    DateTime // GHL order.createdAt, used for day bucketing
  rawPayload    Json? // full order payload, kept for re-processing/debugging
  createdAt     DateTime   @default(now())
  unmatched     UnmatchedTransaction?

  @@index([occurredAt])
  @@index([contactId])
  @@index([funnelStage])
}

// One row per day per campaign/adset/ad, as reported by Meta.
model MetaInsight {
  id            String   @id @default(cuid())
  date          DateTime // day granularity (time truncated to 00:00 UTC)
  level         String // campaign | adset | ad
  campaignId    String
  campaignName  String?
  adsetId       String?
  adsetName     String?
  adId          String?
  adName        String?
  spend         Decimal  @db.Decimal(12, 2)
  purchases     Int      @default(0)
  purchaseValue Decimal  @db.Decimal(12, 2) @default(0)
  reportedRoas  Decimal? @db.Decimal(10, 4)
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  ctr           Decimal  @db.Decimal(8, 4) @default(0)
  frequency     Decimal  @db.Decimal(8, 4) @default(0)
  reach         Int      @default(0)
  rawPayload    Json?
  createdAt     DateTime @default(now())

  @@unique([date, level, campaignId, adsetId, adId])
  @@index([date])
  @@index([adId])
}

// Derived, one row per day — what the daily reconciliation dashboard reads.
model DailyReconciliation {
  date            DateTime @id
  ghlRevenue      Decimal  @db.Decimal(12, 2)
  ghlTransactions Int
  metaRevenue     Decimal  @db.Decimal(12, 2)
  metaPurchases   Int
  gapAmount       Decimal  @db.Decimal(12, 2)
  gapPercent      Decimal  @db.Decimal(6, 2)
  computedAt      DateTime @updatedAt
}

// Derived, one row per day per ad — what the "true ROAS" and missing
// transaction views read.
model AdAttribution {
  id               String   @id @default(cuid())
  date             DateTime
  adId             String
  adsetId          String?
  campaignId       String?
  adName           String?
  metaSpend        Decimal  @db.Decimal(12, 2)
  metaRevenue      Decimal  @db.Decimal(12, 2)
  metaRoas         Decimal? @db.Decimal(10, 4)
  ghlRevenue       Decimal  @db.Decimal(12, 2) // total GHL revenue attributed to this ad
  recoveredRevenue Decimal  @db.Decimal(12, 2) // ghlRevenue not reflected in metaRevenue
  trueRevenue      Decimal  @db.Decimal(12, 2) // metaRevenue + recoveredRevenue
  trueRoas         Decimal? @db.Decimal(10, 4)
  computedAt       DateTime @updatedAt

  @@unique([date, adId])
  @@index([date])
}

// A GHL order with no matching Meta purchase event for its day, surfaced by
// the missing-transaction finder. Persisted (rather than computed on the
// fly) so a manual "confirmed" decision sticks.
model UnmatchedTransaction {
  id            String   @id @default(cuid())
  ghlOrderId    String   @unique
  ghlOrder      GhlOrder @relation(fields: [ghlOrderId], references: [id])
  reason        String // e.g. "no_ad_attribution", "no_meta_purchase_event"
  status        String   @default("NEEDS_REVIEW") // NEEDS_REVIEW | CONFIRMED | DISMISSED
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime @default(now())
}

// Single-row settings table — API keys and alert config for this one-user tool.
model IntegrationSettings {
  id                    Int      @id @default(1)
  ghlApiKey             String?
  ghlLocationId         String?
  metaAccessToken       String?
  metaAdAccountId       String?
  // IANA timezone name. Must match the Meta ad account's own configured
  // reporting timezone for day-bucketed numbers to line up — see
  // lib/timezone.ts.
  reportingTimezone     String   @default("America/Los_Angeles")
  alertThresholdPercent Decimal  @db.Decimal(6, 2) @default(10)
  alertEmail            String?
  lastMetaSyncAt        DateTime?
  lastGhlSyncAt         DateTime?
  lastAlertSentForDate  DateTime? // guards against re-sending the same day's alert twice
  updatedAt             DateTime @updatedAt
}

// One row per Stripe-price-equivalent: maps a GHL product id to a funnel
// stage, filled in manually once real product ids are known.
model ProductFunnelMap {
  productId   String @id
  productName String?
  funnelStage String // FRONT_END | ORDER_BUMP_1 | ORDER_BUMP_2 | UPSELL_1 | UPSELL_2 | UPSELL_3
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Synced from GET /{ad_account_id}/campaigns (separate from MetaInsight,
// which only has performance numbers, not status) — refreshed on the same
// sync cadence as insights, not polled separately.
model MetaCampaign {
  id              String   @id // Meta campaign id
  name            String
  status          String // ACTIVE | PAUSED | DELETED | ARCHIVED
  effectiveStatus String // ACTIVE | PAUSED | CAMPAIGN_PAUSED | ADSET_PAUSED | ...
  objective       String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([status])
}

model MetaAdSet {
  id              String   @id
  name            String
  campaignId      String
  status          String
  effectiveStatus String
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([campaignId])
  @@index([status])
}

model MetaAd {
  id              String   @id
  name            String
  adsetId         String
  campaignId      String
  status          String
  effectiveStatus String
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([adsetId])
  @@index([campaignId])
  @@index([status])
}
